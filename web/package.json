{
  "name": "ticket-hourly-lottery",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run prepare:deployment && vite",
    "prepare:deployment": "node scripts/deployment.mjs prepare",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && npm run prepare:deployment && vite build && node scripts/deployment.mjs manifest",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --import tsx --test tests/protocol.test.mjs && node --import tsx tests/browser.mjs",
    "verify:export": "node scripts/deployment.mjs verify",
    "check:live": "node --import tsx scripts/live.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "viem": "2.56.9"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "playwright": "1.63.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  }
}
